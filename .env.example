# Client-facing env vars (Vite requires the VITE_ prefix to expose these to the browser bundle).
VITE_DEBUG=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by one-off scripts (e.g. scripts/generate-tts-audio-fr.ts), never
# read by client code. Do NOT prefix with VITE_, or it would be bundled into the browser build.
GOOGLE_TTS_API_KEY=
